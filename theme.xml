<theme>
  <formatVersion>7</formatVersion>
  
  <view name="screen">
	
    <controllerActivity name="controllerActivity">
      <pos>0.832 0.025</pos>
      <size>0.085 0.025</size>
      <horizontalAlignment>right</horizontalAlignment>
      <itemSpacing>0.003</itemSpacing>
      <imagePath>./assets/gamepad.svg</imagePath>
      <color>FFFFFF80</color>
      <activityColor>A0A0FFC0</activityColor>
      <hotkeyColor>FFA0A0C0</hotkeyColor>
    </controllerActivity>
	
  </view>
  
  <view name="menu">
  
    <menuText name="menutitle">
      <fontPath>./assets/noto.ttf</fontPath>
      <fontSize>0.044</fontSize>
      <color>ffffff</color>
    </menuText>
	
    <menuText name="menufooter">
      <fontPath>./assets/SST.ttf</fontPath>
      <fontSize>0.02</fontSize>
    </menuText>
	
    <menuText name="menutext">
      <fontPath>./assets/SST.ttf</fontPath>
      <fontSize>0.03</fontSize>
      <color>A6C6D1</color>
      <selectorColor>49585e</selectorColor>
      <selectorColorEnd>303030</selectorColorEnd>
      <selectedColor>ffffff</selectedColor>
      <!-- <separatorColor>0C3F53</separatorColor> -->
      <separatorColor>4d4d4d</separatorColor>
    </menuText>
	
    <menuTextSmall name="menutextsmall">
      <fontPath>./assets/SST.ttf</fontPath>
      <fontSize>0.02</fontSize>
    </menuTextSmall>
	
    <menuBackground name="menubg">
      <color>303030</color>
      <cornerSize>32 32</cornerSize>
      <path>./assets/frame.png</path>
    </menuBackground>
	
  </view>
  
  <view name="system">
  
    <image name="staticBackground">
      <size>1 1</size>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <tile>false</tile>
      <linearSmooth>true</linearSmooth>
      <path>./assets/bg.png</path>
      <zIndex>0</zIndex>
      <color>808080</color>
    </image>
	
    <image name="logo">
      <path>./art/${system.theme}.svg</path>
	    <path>./art/${system.theme}.png</path>
      <!-- <reflexion>0.16 0.0</reflexion> -->
      <!-- <verticalAlignment>bottom</verticalAlignment> -->
      <reflexionOnFrame>true</reflexionOnFrame>
    </image>
	
    <text name="logoText">
      <fontPath>./assets/miss.ttf</fontPath>
      <fontSize>0.092</fontSize>
      <color>FFFFFFFF</color>
      <reflexion>0.16 0.0</reflexion>
      <reflexionOnFrame>true</reflexionOnFrame>
    </text>
	
  </view>
  
  <view name="basic">
  
    <text name="description" extra="true">
      <pos>0.605 0.685</pos>
      <size>0.347 0.183</size>
      <alignment>center</alignment>
      <color>ffffff</color>
      <fontSize>0.025</fontSize>
      <text>No Information Available</text>
      <fontPath>./assets/noto.ttf</fontPath>
    </text>
	
    <image name="none" extra="true">
      <origin>0.5 0.5</origin>
      <pos>0.776 0.388</pos>
      <maxSize>0.347 0.46</maxSize>
      <path>./assets/no_boxart.png</path>
    </image>
	
  </view>
  
  <view name="basic, detailed, grid">
	
    <image name="background" extra="true">
      <size>1 1</size>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <path>./assets/bg.png</path>
      <zIndex>0</zIndex>
      <color>10667f</color>
    </image>
	
    <!-- <image name="backgroundx" extra="true">
      <size>1 1</size>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <path>./assets/gamelist.png</path>
      <zIndex>0</zIndex>
      <color>FFFFFFFF</color>
    </image> -->
	
    <text name="system_name" extra="true">
      <text>${system.fullName}</text>
      <forceUppercase>0</forceUppercase>
      <size>0.5 0.025</size>
      <pos>0.02 0.025</pos>
      <color>ffffff</color>
      <fontPath>./assets/SST.ttf</fontPath>
      <fontSize>0.04</fontSize>
      <zIndex>2</zIndex>
    </text>
	
    <text name="md_lbl_genre, md_genre, md_lbl_rating, md_lbl_developer, md_lbl_publisher, md_publisher, md_lbl_lastplayed, md_lbl_playcount, md_playcount, md_lbl_releasedate">
      <visible>false</visible>
    </text>
	
    <!-- <rating name="md_rating">
      <visible>false</visible>
    </rating> -->
	
    <!-- <image name="md_thumbnail">
      <visible>false</visible>
      <origin>0.5 0.5</origin>
      <pos>0.5 0.5</pos>
      <minSize>1.25 1.25</minSize>
      <color>FFFFFF0A</color>
    </image> -->
	
    <video name="md_video">
	
      <origin>0.5 0.5</origin>
      <pos>0.776 0.388</pos>
      <maxSize>0.347 0.46</maxSize>
      <delay>1.5</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <snapshotSource>image</snapshotSource>
	    <effect>none</effect>
    </video>

      <rating name="md_rating">
         <!-- <pos>0.605 0.600</pos> -->
      <pos>0.7 0.69</pos>
         <size>0 0.04</size>
         <zIndex>12</zIndex>
         <filledPath>./assets/rating_filled.svg</filledPath>
         <unfilledPath>./assets/rating_unfilled.svg</unfilledPath>
         <visible>true</visible>
      </rating>
      
      <text name="md_genre">
        <pos>0.605 0.8</pos>
        <size>0.347 0.06</size>
        <color>ffffff</color>
        <fontSize>0.025</fontSize>
        <fontPath>./assets/noto.ttf</fontPath>
        <alignment>center</alignment>
        <visible>true</visible>
      </text>
	
    <!-- <text name="md_description">
	
      <pos>0.605 0.685</pos>
      <size>0.347 0.183</size>
      <color>ffffff</color>
      <fontSize>0.025</fontSize>
      <fontPath>./assets/noto.ttf</fontPath>
	  
    </text> -->
	
    <image name="logo">
      <pos>1 1</pos>
      <color>00000000</color>
      <path>./assets/box.png</path>
    </image>
	
  </view>
  
  <view name="basic, detailed">
  
    <textlist name="gamelist">
      <selectorColor>49585e</selectorColor>
      <selectorColorEnd>303030</selectorColorEnd>
      <selectedColor>ffffff</selectedColor>
      <primaryColor>ffffff</primaryColor>
      <secondaryColor>ffffff</secondaryColor>
      <!-- <fontPath>./assets/SST.ttf</fontPath> -->
      <fontSize>0.025</fontSize>
      <pos>0.051 0.170</pos>
      <size>0.50 0.70</size>
      <alignment>left</alignment>
      <horizontalMargin>0.01</horizontalMargin>
      <origin>0 0</origin>
      <lineSpacing>2.1</lineSpacing>
      <!-- <selectorImagePath>./assets/box.png</selectorImagePath> -->
      <!-- <selectorOffsetY>0</selectorOffsetY>
      <selectorHeight>0.05625</selectorHeight> -->
    </textlist>
	
  </view>
  
  <view name="grid">
  
    <image name="md_image">
      <visible>false</visible>
    </image>
	
    <text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount">
      <color>A0A0B000</color>
    </text>
	
    <text name="md_developer, md_publisher, md_genre, md_players, md_playcount">
      <color>ffffff00</color>
    </text>
	
    <datetime name="md_releasedate, md_lastplayed">
      <color>ffffff00</color>
    </datetime>
	
    <text name="md_rating">
      <pos>0.88 0.88</pos>
      <size>0.05 0.03</size>
    </text>
	
    <text name="md_name">
      <color>ffffffff</color>
      <pos>0.051 0.16</pos>
      <size>0.50 0.07</size>
      <alignment>center</alignment>
      <glowColor>00000005</glowColor>
      <glowSize>3</glowSize>
    </text>
	
    <imagegrid name="gamegrid">
      <pos>0.047 0.200</pos>
      <size>0.51 0.67</size>
      <margin>0.005 0.010</margin>
      <padding>0.03 0.05 0.03 0.04</padding>
      <autoLayout>3 1</autoLayout>
      <autoLayoutSelectedZoom>1.40</autoLayoutSelectedZoom>
      <animateSelection>false</animateSelection>
      <scrollDirection>horizontal</scrollDirection>
      <centerSelection>true</centerSelection>
      <scrollLoop>true</scrollLoop>
    </imagegrid>
	
    <gridtile name="default">
      <backgroundColor>FFFFFF00</backgroundColor>
      <backgroundCornerSize>9 9</backgroundCornerSize>
      <selectionMode>image</selectionMode>
      <padding>5 5</padding>
      <imageColor>FFFFFF90</imageColor>
      <reflexion>0.24 0.0</reflexion>
    </gridtile>
	
    <gridtile name="selected">
      <backgroundColor>FFFFFF00</backgroundColor>
      <imageColor>FFFFFFFF</imageColor>
    </gridtile>
    <!--
    <text name="gridtile">
      <color>D0D0D0</color>
      <backgroundColor>00000000</backgroundColor>
      <fontSize>0.022</fontSize>
      <alignment>center</alignment>
      <size>1 0.24</size>
    </text>
    <text name="gridtile_selected">
      <color>FFFFFF</color>
      <glowColor>${glowColor}</glowColor>
      <glowSize>3</glowSize>
    </text>-->
  </view>
  <view name="system">

<carousel name="systemcarousel">
      <type>horizontal</type>
      <size>1 1</size>
      <pos>0 0.33</pos>
      <origin>0 0</origin>
      <logoSize>0.12 0.10</logoSize>

      <logoPos>-1 0.1</logoPos>
      <maxLogoCount>6</maxLogoCount>
      <logoScale>2</logoScale>
      
      
      <color>ffffff00</color>
      <defaultTransition>fade</defaultTransition>
      <zIndex>10</zIndex>
    </carousel>
    
    <!-- SYSTEMS -->
    <text name="systemName" extra="true">
      <text>${system.fullName}</text>
      <fontSize>0.04</fontSize>
      <fontPath>./../assets/SST.ttf</fontPath>
      <lineSpacing>1</lineSpacing>
      <alignment>center</alignment>
      <forceUppercase>1</forceUppercase>
      <color>ffffff</color>

      <!-- <origin>0 0</origin> -->
      <pos>0 0.3</pos>
      <size>1 0.04</size>
      <zIndex>15</zIndex>
    </text>

    <text name="systemInfo">
      <pos>0 0.77</pos>
      <size>1 0.25</size>
      <backgroundColor>00000000</backgroundColor>
      <color>ffffff</color>
      <fontPath>./assets/SST.ttf</fontPath>
      <fontSize>0.03</fontSize>
    </text>
	
  </view>
  
  <variables>
	  <fullscreenfixSubsetname>Emulationstation Screen Size</fullscreenfixSubsetname>
	  <backgroundSubsetName>Choose Background</backgroundSubsetName>
  </variables>
  
  <subset name="fullscreenfix" displayName="${fullscreenfixSubsetname}">
  <include name="4:3">./fullscreenv.xml</include>
  <include name="ES Header">./header.xml</include>
  <include name="ES Fullscreen">./fullscreen.xml</include>
  </subset>

  <subset name="background" displayName="${backgroundSubsetname}">
    <include name="final-fantasy-pixel">./assets/final-fantasy-pixel.xml</include>
    <include name="minimal"/>
    <include name="circuit">./assets/circuit.xml</include>
    <include name="dark-fantasy">./assets/dark-fantasy.xml</include>
    <include name="final-fantasy">./assets/final-fantasy.xml</include>
    <include name="mystic-fantasy">./assets/mystic-fantasy.xml</include>
    <include name="nature">./assets/nature.xml</include>
    <include name="retro-room">./assets/retro-room.xml</include>
    <include name="steam-punk">./assets/steam-punk.xml</include>
  </subset>
  
</theme>
